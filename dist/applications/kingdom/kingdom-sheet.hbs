<div>
    <header class="km-kingdom-sheet-header">
        <div class="km-kingdom-sheet-name"><i class="fa-solid fa-crown"></i> {{> formElement kingdomNameInput }}</div>
        <div class="km-kingdom-faith-counter-slot"></div>
        <div class="km-kingdom-turn-counter-slot"></div>
        <div class="km-fame">{{> formElement fameContext.now }}
            {{> formElement fameContext.next }}</div>
        <div class="km-xp-level-section">
            <div class="km-kingdom-sheet-active-xp">{{> formElement xpInput }}/{{> formElement xpThresholdInput }}{{localizeKM "applications.xp"}}
            </div>
            <div class="km-kingdom-sheet-active-level">{{> formElement levelInput }}</div>
        </div>
    </header>

    {{> tabs mainNav}}

    <main class="km-kingdom-sheet-main" style="background-image: url({{sheetBackground}})">
        {{#if (eq currentNavEntry 'kingdom')}}{{> kingdom-character-sheet this}}{{/if}}
        {{#if (eq currentNavEntry 'notes')}}{{> kingdom-notes this}}{{/if}}
        {{#if (eq currentNavEntry 'turn')}}{{> kingdom-turn this}}{{/if}}
        {{#if (eq currentNavEntry 'tradeAgreements')}}{{> kingdom-trade-agreements this}}{{/if}}
        {{#if (eq currentNavEntry 'settlements')}}{{> kingdom-settlements this}}{{/if}}
        {{#if (eq currentNavEntry 'modifiers')}}{{> kingdom-modifiers this}}{{/if}}
    </main>
</div>
